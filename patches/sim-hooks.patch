+# --- SIM PATCH (not upstream): memoize the last decode. unwrapReceivedMessage
+# decodes the same bytes twice (extractChannelId, then deserializeMessage);
+# decoding is a pure function, so caching the last input changes no behaviour.
+var sdsSimDecodeCache*: bool = false
+var lastDecodeIn {.threadvar.}: seq[byte]
+var lastDecodeOut {.threadvar.}: Result[SdsMessage, ReliabilityError]
+var lastDecodeValid {.threadvar.}: bool
+
+proc deserializeMessage*(data: seq[byte]): Result[SdsMessage, ReliabilityError] {.gcsafe.} =
+  {.cast(gcsafe).}:
+    if sdsSimDecodeCache:
+      if lastDecodeValid and data == lastDecodeIn:
+        return lastDecodeOut
+      let r = deserializeMessageImpl(data)
+      lastDecodeIn = data
+      lastDecodeOut = r
+      lastDecodeValid = true
+      return r
+  deserializeMessageImpl(data)
+# --- end SIM PATCH ---
